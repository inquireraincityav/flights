# ============================================================
# Flight Price Monitor — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Trip Details ---
ORIGIN=YVR
DESTINATION=BOM
DEPARTURE_START=2026-12-11
DEPARTURE_END=2026-12-15
RETURN_START=2027-01-03
RETURN_END=2027-01-05
PASSENGERS=1
CABIN_CLASS=economy

# --- Price Targets (CAD) ---
MIN_TARGET_PRICE_CAD=1800
MAX_TARGET_PRICE_CAD=2600
INSANE_DEAL_MAX_CAD=1799
EXCELLENT_DEAL_MAX_CAD=2099
GREAT_DEAL_MAX_CAD=2299
GOOD_DEAL_MAX_CAD=2600

# --- Alert Thresholds ---
PRICE_DROP_ALERT_CAD=150
SECONDARY_PRICE_DROP_ALERT_CAD=50
CHECK_INTERVAL_HOURS=4
ALERT_COOLDOWN_HOURS=24

# --- Baggage ---
CHECKED_BAGS_PER_PASSENGER=1
REQUIRE_CHECKED_BAG=true

# --- Itinerary Preferences ---
MAX_STOPS=2
MAX_PREFERRED_DURATION_HOURS=30
MAX_PREFERRED_LAYOVER_HOURS=12
MIN_CONNECTION_MINUTES=75
DIRECT_BOOKING_PREMIUM_CAD=100

# --- Timezone ---
TIMEZONE=America/Vancouver

# --- Telegram ---
# See README.md for setup instructions
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Browser Automation ---
HEADLESS=true

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# --- Currency ---
# Free ExchangeRate API (no key needed for basic use)
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/CAD

# --- Deal Scoring Weights (must sum to 1.0) ---
SCORE_WEIGHT_PRICE=0.45
SCORE_WEIGHT_STOPS=0.15
SCORE_WEIGHT_DURATION=0.10
SCORE_WEIGHT_BAGGAGE=0.10
SCORE_WEIGHT_DIRECT_BOOKING=0.10
SCORE_WEIGHT_CONFIDENCE=0.05
SCORE_WEIGHT_CONNECTION=0.05

# --- Dynamic Check Intervals ---
DYNAMIC_CHECK_ENABLED=true
CHECK_INTERVAL_60PLUS_DAYS=6
CHECK_INTERVAL_30_60_DAYS=4
CHECK_INTERVAL_14_30_DAYS=2
CHECK_INTERVAL_UNDER_14_DAYS=1

# --- Daily Summary ---
DAILY_SUMMARY_HOUR=20
DAILY_SUMMARY_MINUTE=0
